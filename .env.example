# Copier en `.env` (gitignoré) et renseigner selon les lots.
# .env est ignoré par git ; ce fichier .env.example documente les variables attendues.

# Lot 5 — SEC EDGAR : User-Agent descriptif obligatoire (nom et email de contact),
# cf. https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT="Analyse Financiere Master DS (ton.email@exemple.tn)"

# Lot 5 — Financial Modeling Prep (optionnel, clé gratuite limitée).
# Laisser vide si on n'utilise que SEC EDGAR + Damodaran + le benchmark de repli.
FMP_API_KEY=
